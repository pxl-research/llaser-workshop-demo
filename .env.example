# Copy to .env (cp .env.example .env) and fill in the empty values.

# Your personal OpenRouter key, from your workshop link. Required.
OPENROUTER_API_KEY=
# Chat model on OpenRouter. Keep as is.
LLM=meta-llama/llama-3.3-70b-instruct

# LLM defense on the PXL DGX Spark. Keep false: switch it on in the Controls page.
USE_HOMEBREW=false
# URL and key from your workshop link. The URL has no /v1 at the end.
HOMEBREW_BASE_URL=
HOMEBREW_API_KEY=
HOMEBREW_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
HOMEBREW_TIMEOUT_SECONDS=20

# NLP defense on this laptop. Keep false: switch it on in the Controls page.
USE_NLP_DEFENSE=false
# Password of the encrypted NLP model, from your workshop link. The app downloads and installs the model itself.
MODEL_PASSWORD=

# Optional: another port if 8080 is taken; then open http://127.0.0.1:<port>
# LLASER_PORT=8081
